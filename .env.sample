BOT_TOKEN=1234567890:AAAAA0000
# Model: "parakeet" (NVIDIA Parakeet-TDT 0.6B v3, fast on CPU, 25 European languages)
# or a Whisper size: tiny, base, small, medium, turbo, large-v2, large-v3.
# Comma-separated values enable multi-config debug mode (e.g., parakeet,medium)
BOT_MODEL=parakeet
# Used by Whisper (Parakeet detects the language automatically)
LANGUAGE=it
# Whisper beam size(s) - comma-separated for multi-config debug mode (e.g., 1,3,5)
BEAM_SIZE=1
# VAD filter(s) - comma-separated for multi-config debug mode (e.g., true,false)
VAD_FILTER=false
# CPU thread count(s), 0 = all cores. Use cores-1 if other services keep the CPU busy
THREADS=0
BOT_NAME=
# Optional: receive startup notification in this chat
ADMIN_CHAT_ID=
# Strongly recommended: comma-separated chat IDs allowed to use the bot (groups are negative)
ALLOWED_CHAT_IDS=

# Seconds to wait before posting the "Transcribing..." placeholder (fast notes arrive as one message)
# PLACEHOLDER_DELAY=1.0
# Whisper decoder knobs (defaults are tuned for speed on short voice notes)
# WHISPER_TIMESTAMPS=false   # true = old behaviour, can double encoder passes on short notes
# WHISPER_FALLBACK=false     # true = re-decode with higher temperatures when unsure (slow)

# Multi-config mode example:
# BOT_MODEL=parakeet,small
# BEAM_SIZE=1,5
# This would test 3 combinations (parakeet ignores beam size)
